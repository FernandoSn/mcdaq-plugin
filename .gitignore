# Files and folders to ignore

# 1. intermediate files
*.o
*.d


# 2. Build files

**/Build/*
!**/Build/CMakeLists.txt
!**/Build/CMAKE_README.txt




# CMake / Visual Studio generated files
Build/*
!Build/.gitkeep
.vs/
CMakeFiles/
CMakeCache.txt
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Compiled binaries
*.obj
*.pdb
*.dll
*.exe
*.lib
